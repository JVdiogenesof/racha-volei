# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Supabase
# (Project Settings > API no painel do Supabase).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Usada só em scripts de servidor (migrations). NUNCA exponha no client.
DATABASE_URL=postgresql://postgres:SUA-SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Notificação push (VAPID). Gere um par novo com "npx web-push generate-vapid-keys"
# -- as duas chaves abaixo são o MESMO par (a pública precisa do prefixo NEXT_PUBLIC_
# pra chegar até o navegador). Nunca reaproveite esse exemplo em produção.
VAPID_PRIVATE_KEY=sua-chave-privada-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
